{
  "name": "@teechat/ope-protocol",
  "version": "0.1.0",
  "description": "TypeScript binding for OPE wire protocol (Rust SoT: crates/ope-protocol). Types + NDJSON stream codec only — no crypto.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lightec-AI/OPE.git",
    "directory": "bindings/typescript/ope-protocol"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./stream": {
      "types": "./src/stream.ts",
      "import": "./src/stream.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "tsx --test src/protocol.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
